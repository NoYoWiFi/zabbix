# 服务配置
HOST=0.0.0.0
PORT=8000
ROOT_PATH=/monitor

MONITOR_TABLE_CONFIG=/usr/share/zabbix/monitor/backend/monitor_config.py

# 脚本目录
PROJECT_ROOT=/usr/share/zabbix/monitor/backend
SCRIPTS_DIR=${PROJECT_ROOT}/scripts
SCRIPTS_TMP_DIR=${PROJECT_ROOT}/scripts/tmp
OUTPUT_DIR=${PROJECT_ROOT}/output
TMP_DIR=${PROJECT_ROOT}/tmp
LOGS_DIR=/usr/share/zabbix/monitor/backend/logs
PIPELINE_LOGS_DIR=/usr/share/zabbix/monitor/backend/logs/pipeline_logs
TERMINAL_LOGS_DIR=/usr/share/zabbix/monitor/backend/logs/terminal_logs
PYTHON_EXE=/usr/share/zabbix/monitor/backend/venv_3_11_13_x86_64/bin/python3

# API 配置
API_PREFIX=/api/v1

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=zabbix
DB_PASSWORD=Admin@zabbix.com
DB_NAME=monitor
DB_CHARSET=utf8mb4

# clickhouse
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=zabbix
CLICKHOUSE_PASSWORD=Admin@zabbix.com
CLICKHOUSE_DATABASE=monitor

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=Admin@zabbix.com
REDIS_TASK_TTL=3600

# API 配置
CORS_ORIGINS=*


