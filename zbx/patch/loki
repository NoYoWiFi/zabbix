/var/log/loki/*.log {
        daily
        rotate 90
        dateext
        missingok
        notifempty
        maxsize 1G
        compress
        delaycompress
        create 0666 root root
        sharedscripts
        postrotate
            /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
        endscript
}
