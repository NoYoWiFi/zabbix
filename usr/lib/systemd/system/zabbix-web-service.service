[Unit]
Description=Zabbix Web Service
After=syslog.target
After=network.target

[Service]
Environment="LD_LIBRARY_PATH=/usr/local/src/perl5-5.26.3:/usr/local/lib:/usr/local/lib64"
Environment="CONFFILE=/etc/zabbix/zabbix_web_service.conf"
EnvironmentFile=-/etc/default/zabbix_web_service
Type=simple
Restart=on-failure
KillMode=control-group
ExecStart=/usr/sbin/zabbix_web_service -c $CONFFILE
ExecStop=/bin/kill -SIGTERM $MAINPID
RestartSec=10s
User=zabbix
Group=zabbix

[Install]
WantedBy=multi-user.target
